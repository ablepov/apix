{% extends "../layout.twig" %}

{% block title %}Услуги — АПИКС{% endblock %}

{% block content %}
<span class="plug"></span>

				<section class="services-page">
	<div class="services-page__container container">
		<h1 class="services-page__title title-page">УСЛУГИ</h1>

		<ul class="services-page__list">
			<li class="services-page__item" id="service-1">
				<a class="services-page__link" href="inner-service.html">
					<img class="services-page__img" src="images/services/1.svg" alt="">

					<p class="services-page__text">Авторский надзор</p>
				</a>
			</li>

			<li class="services-page__item" id="service-2">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/2.svg" alt="">

					<p class="services-page__text">Инженерные изыскания</p>
				</div>
			</li>

			<li class="services-page__item" id="service-3">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/3.svg" alt="">

					<p class="services-page__text">Конструктивные расчеты зданий и сооружений</p>
				</div>
			</li>

			<li class="services-page__item" id="service-4">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/4.svg" alt="">

					<p class="services-page__text">Сопровождение проектной
						документации</p>
				</div>
			</li>

			<li class="services-page__item" id="service-5">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/5.svg" alt="">

					<p class="services-page__text">Обследование для оценки технического состояния зданий и сооружений</p>
				</div>
			</li>

			<li class="services-page__item" id="service-6">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/6.svg" alt="">

					<p class="services-page__text">Получение исходно-разрешительной документации</p>
				</div>
			</li>

			<li class="services-page__item" id="service-7">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/7.svg" alt="">

					<p class="services-page__text">Разработка полного перечня разделов проектной и рабочей документации</p>
				</div>
			</li>

			<li class="services-page__item" id="service-8">
				<div class="services-page__link">
					<img class="services-page__img" src="images/services/8.svg" alt="">

					<p class="services-page__text">Оказание содействия при вводе объекта в эксплуатацию</p>
				</div>
			</li>
		</ul>
	</div>
</section>
