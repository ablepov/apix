{% extends "../layout.twig" %}

{% block title %}АПИКС — проектирование зданий и инженерных систем{% endblock %}

{% block content %}
<span class="plug"></span>

				<section class="main-hero">
	<div class="main-hero__container container">
		<div class="main-hero__text">
			<h1 class="main-hero__title title-page">АПИКС</h1>

			<p class="main-hero__descr">ПРОЕКТИРОВАНИЕ Зданий <br>Сооружений Инженерных систем</p>
		</div>

		<div class="main-hero__image-box">
			<img class="main-hero__img" src="images/house.png" width="855" height="907" fetchpriority="high" alt="">
			<div class="main-hero__aria"></div>
		</div>
	</div>
</section>

				<section class="services">
	<div class="services__container container">
		<div class="services__body">
			<div class="services__top section-trigger">
				<h2 class="services__title title">УСЛУГИ</h2>

				<a class="services__link-all link" href="services.html">Все услуги</a>
			</div>

			<ul class="services__list section-trigger">
				<li class="services__item">
					<a class="services__link services__link--active" href="services.html#service-2">Инженерные изыскания</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="inner-service.html">Авторский надзор</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-4">Сопровождение проектной документации</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-3">Конструктивные расчеты зданий и сооружений</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-6">Получение исходно-разрешительной документации</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-8">Оказание содействия при вводе объекта в эксплуатацию</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-7">Разработка полного перечня разделов проектной и рабочей документации</a>
				</li>

				<li class="services__item">
					<a class="services__link" href="services.html#service-5">Обследование для оценки технического состояния зданий и сооружений</a>
				</li>
			</ul>
		</div>

		<ul class="services__info services-info section-trigger">
			<li class="services-info__item services-info__item--active">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/2.svg" alt="">

					<h3 class="services-info__title">Инженерные изыскания</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/1.svg" alt="">

					<h3 class="services-info__title">Авторский надзор</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/4.svg" alt="">

					<h3 class="services-info__title">Сопровождение проектной документации</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/3.svg" alt="">

					<h3 class="services-info__title">Конструктивные расчеты зданий и сооружений</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/6.svg" alt="">

					<h3 class="services-info__title">Получение исходно-разрешительной документации</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/8.svg" alt="">

					<h3 class="services-info__title">Оказание содействия при вводе объекта в эксплуатацию</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/7.svg" alt="">

					<h3 class="services-info__title">Разработка полного перечня разделов проектной и рабочей документации</h3>

					<p class="services-info__descr">Все виды проектирования от подготовки исходно разрешительной документации до выполнение проектной и рабочей документации строительства.</p>
				</article>
			</li>

			<li class="services-info__item">
				<article class="services-info__card">
					<img class="services-info__img" src="images/services/5.svg" alt="">

					<h3 class="services-info__title">Обследование для оценки технического состояния зданий и сооружений</h3>

					<p class="services-info__descr">Описание</p>
				</article>
			</li>
		</ul>
	</div>
</section>

				<section class="project-carousel">
	<div class="project-carousel__container container">
		<div class="project-carousel__top">
			<h2 class="project-carousel__title title section-trigger">Проекты</h2>

			<a class="project-carousel__link-all link" href="projects.html">Все проекты</a>
		</div>

		<div class="project-carousel__body section-trigger">
			<button class="project-carousel__btn project-carousel__btn--prev btn btn--left" type="button">
				<span class="sr-only">Предыдущий слайд</span>
			</button>

			<div class="project-carousel__slider swiper swiper-container">
				<ul class="project-carousel__wrapper swiper-wrapper">
					<li class="project-carousel__item swiper-slide">
						<a class="project-carousel__link" href="inner-project.html">
							<div class="project-carousel__image-box">
								<picture>
									<source type="image/webp" srcset="images/projects/8.webp">
									<img loading="lazy" class="project-carousel__img" src="images/projects/8.jpg" alt="">
								</picture>
							</div>

							<p class="project-carousel__text">Многоквартирный жилой дом с подземной автостоянкой</p>
						</a>
					</li>

					<li class="project-carousel__item swiper-slide">
						<div class="project-carousel__link">
							<div class="project-carousel__image-box">
								<picture>
									<source type="image/webp" srcset="images/projects/5.webp">
									<img loading="lazy" class="project-carousel__img" src="images/projects/5.jpg" alt="">
								</picture>
							</div>

							<p class="project-carousel__text">Веревочный парк «Космопорт»</p>
						</div>
					</li>

					<li class="project-carousel__item swiper-slide">
						<div class="project-carousel__link">
							<div class="project-carousel__image-box">
								<picture>
									<source type="image/webp" srcset="images/projects/9.webp">
									<img loading="lazy" class="project-carousel__img" src="images/projects/9.jpg" alt="">
								</picture>
							</div>

							<p class="project-carousel__text">Многоквартирный ЖК «Водопад»</p>
						</div>
					</li>

					<li class="project-carousel__item swiper-slide">
						<div class="project-carousel__link">
							<div class="project-carousel__image-box">
								<picture>
									<source type="image/webp" srcset="images/projects/clinic-card.webp">
									<img loading="lazy" class="project-carousel__img" src="images/projects/clinic-card.jpg" alt="">
								</picture>
							</div>

							<p class="project-carousel__text">Поликлиника КГБУЗ «Красноармейская ЦРБ»</p>
						</div>
					</li>

					<li class="project-carousel__item swiper-slide">
						<div class="project-carousel__link">
							<div class="project-carousel__image-box">
								<picture>
									<source type="image/webp" srcset="images/projects/1.webp">
									<img loading="lazy" class="project-carousel__img" src="images/projects/1.jpg" alt="">
								</picture>
							</div>

							<p class="project-carousel__text">Ворота здания авиационно-технической базы №1</p>
						</div>
					</li>
				</ul>
			</div>

			<button class="project-carousel__btn project-carousel__btn--next btn btn--right" type="button">
				<span class="sr-only">Следующий слайд</span>
			</button>
		</div>
	</div>
</section>
{% endblock %}
